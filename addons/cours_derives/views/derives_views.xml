<odoo>
    <record id="view_forward_form" model="ir.ui.view">
        <field name="name">cours.forward.form</field>
        <field name="model">cours.forward</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="S0"/>
                        <field name="r"/>
                        <field name="T"/>
                        <field name="F0"/>
                    </group>
                    <group string="Évaluation en cours de vie">
                        <field name="t_elapsed"/>
                        <field name="S_t"/>
                        <field name="value"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_forward_tree" model="ir.ui.view">
        <field name="name">cours.forward.tree</field>
        <field name="model">cours.forward</field>
        <field name="arch" type="xml">
            <tree decoration-success="value &gt; 0" decoration-danger="value &lt;= 0">
                <field name="name"/>
                <field name="S0"/>
                <field name="r"/>
                <field name="T"/>
                <field name="F0"/>
                <field name="t_elapsed"/>
                <field name="S_t"/>
                <field name="value"/>
            </tree>
        </field>
    </record>

    <record id="action_forward" model="ir.actions.act_window">
        <field name="name">Forwards</field>
        <field name="res_model">cours.forward</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_option_form" model="ir.ui.view">
        <field name="name">cours.option.form</field>
        <field name="model">cours.option</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="option_type"/>
                        <field name="S_T"/>
                        <field name="K"/>
                        <field name="premium"/>
                        <field name="payoff"/>
                        <field name="profit"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_option_tree" model="ir.ui.view">
        <field name="name">cours.option.tree</field>
        <field name="model">cours.option</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="option_type"/>
                <field name="S_T"/>
                <field name="K"/>
                <field name="premium"/>
                <field name="payoff"/>
                <field name="profit"/>
            </tree>
        </field>
    </record>

    <record id="action_option" model="ir.actions.act_window">
        <field name="name">Options</field>
        <field name="res_model">cours.option</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_derives_root" name="Derives" sequence="10"/>
    <menuitem id="menu_forward" name="Forwards" parent="menu_derives_root" action="action_forward"/>
    <menuitem id="menu_option" name="Options" parent="menu_derives_root" action="action_option"/>
</odoo>